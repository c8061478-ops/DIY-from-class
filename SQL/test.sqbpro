mn_widths><column index="1" value="84"/><column index="2" value="74"/><column index="3" value="69"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Membre" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="73"/><column index="2" value="63"/><column index="3" value="55"/><column index="4" value="143"/><column index="5" value="97"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">/*
SELECT Coach.nom, count(Activite.nom_activite) 
FROM Coach
INNER JOIN Activite ON Activite.id_coach = Coach.id_coach
GROUP BY Coach.id_coach
SELECT Coach.nom, Activite.nom_activite 
FROM Coach
INNER JOIN Activite ON Activite.id_coach = Coach.id_coach
SELECT Membre.nom, Membre.prenom, count(Inscription.id_activite)
FROM Membre
INNER JOIN Inscription ON Inscription.id_membre = Membre.id_membre
GROUP BY Inscription.id_membre
SELECT Coach.nom, count(Activite.nom_activite) AS 'test'
FROM Coach
INNER JOIN Activite ON Activite.id_coach = Coach.id_coach
GROUP BY Coach.id_coach
HAVING test &gt; 1
SELECT nom, prenom, date_naissance FROM Membre WHERE date_naissance &gt; '2008-01-01'
INSERT INTO Inscription VAlUES('I16', 'M1', 'A8', '2026-09-10')
UPDATE Membre
SET ville = 'Lens'
WHERE id_membre = 'M5'
///
SELECT Membre.nom, Activite.nom_activite
FROM Membre
INNER JOIN Inscription ON Inscription.id_membre = Membre.id_membre
INNER JOIN Activite ON Inscription.id_activite = Activite.id_activite
INNER JOIN Coach ON Activite.id_coach = Coach.id_coach
WHERE Coach.nom = 'Fontaine'
SELECT Activite.nom_activite, count(Inscription.id_activite) AS 'nb_a'
FROM Inscription
INNER JOIN Activite ON Inscription.id_activite = Activite.id_activite
GROUP BY Activite.nom_activite
HAVING nb_a &gt; 1
ORDER BY nb_a
*/</sql><current_tab id="0"/></tab_sql></sqlb_project>
